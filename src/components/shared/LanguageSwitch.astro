---
interface Props {
  locale: string;
  altLang: string;
}

const { locale, altLang } = Astro.props;
const currentPath = Astro.url.pathname;
const altPath = locale === 'zh'
  ? currentPath.replace('/zh/', '/en/')
  : currentPath.replace('/en/', '/zh/');
---

<a
  href={altPath}
  class="text-xs font-medium px-3 py-1.5 rounded-full border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
>
  {altLang === 'en' ? 'EN' : '中文'}
</a>

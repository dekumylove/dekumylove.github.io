---
import LanguageSwitch from '../shared/LanguageSwitch.astro';
import DarkModeToggle from '../shared/DarkModeToggle.astro';
import { useTranslations } from '../../lib/i18n';

const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh';
const t = useTranslations(locale);
const altLang = locale === 'zh' ? 'en' : 'zh';

const navItems = [
  { key: 'home', href: `/${locale}/` },
  { key: 'academic', href: `/${locale}/academic/` },
  { key: 'blog', href: `/${locale}/blog/` },
  { key: 'experience', href: `/${locale}/experience/` },
  { key: 'activities', href: `/${locale}/activities/` },
];
---

<nav class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-gray-950/80 border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href={`/${locale}/`} class="text-lg font-bold text-gray-900 dark:text-white hover:opacity-70 transition-opacity">
      {locale === 'en' ? 'Hao Wang' : '王浩'}
    </a>

    <div class="hidden md:flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          {t(`nav.${item.key}`)}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <DarkModeToggle locale={locale} />
      <LanguageSwitch locale={locale} altLang={altLang} />
    </div>
  </div>
</nav>

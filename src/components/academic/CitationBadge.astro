---
interface Props {
  count: number;
  locale: string;
}

const { count, locale } = Astro.props;
const label = locale === 'zh' ? '引用' : 'citations';
---

<div
  class="flex-shrink-0 flex flex-col items-center justify-center w-16 h-16 rounded-lg bg-blue-50 dark:bg-blue-950/50"
  title={`${count} ${label}`}
>
  <span class="text-lg font-bold text-blue-600 dark:text-blue-400">{count}</span>
  <span class="text-[10px] text-blue-500 dark:text-blue-500">{label}</span>
</div>

---
interface Props {
  name: string;
}

const { name } = Astro.props;

const colors: Record<string, string> = {
  Astro: 'bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300',
  TypeScript: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300',
  JavaScript: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300',
  React: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/50 dark:text-cyan-300',
  Preact: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300',
  'Tailwind CSS': 'bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300',
  Python: 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300',
  Rust: 'bg-orange-100 text-orange-800 dark:bg-orange-900/50 dark:text-orange-300',
};

const colorClass = colors[name] ?? 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300';
---

<span class={`inline-block px-2 py-0.5 rounded-md text-xs font-mono font-medium ${colorClass}`}>
  {name}
</span>

---
import TagBadge from './TagBadge.astro';
import PostMeta from './PostMeta.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: string;
}

const { post, locale } = Astro.props;
const { title, date, tags } = post.data;
---

<a
  href={`/${locale}/blog/${post.id.replace(/^(zh|en)\//, '').replace(/\.md$/, '')}/`}
  class="block p-6 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700 hover:shadow-md transition-all duration-200"
>
  <h3 class="text-lg font-bold text-gray-900 dark:text-white line-clamp-2">
    {title}
  </h3>
  <PostMeta date={date} locale={locale} body={post.body ?? ''} />
  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
    {post.body?.slice(0, 200) ?? ''}
  </p>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => <TagBadge tag={tag} />)}
    </div>
  )}
</a>

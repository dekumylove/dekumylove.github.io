---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import TagBadge from '../components/blog/TagBadge.astro';
import { formatDate, readingTime } from '../lib/utils';
import { useTranslations } from '../lib/i18n';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  body: string;
}

const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh';
const t = useTranslations(locale);
const { title, date, tags, body } = Astro.props;
const readMin = readingTime(body);
---

<BaseLayout title={title} locale={locale}>
  <Nav />
  <main class="blog-module min-h-screen">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
          {title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
          <time datetime={date.toISOString()}>
            {t('blog.postedOn', { date: formatDate(date, locale) })}
          </time>
          <span>·</span>
          <span>{t('blog.minRead', { min: String(readMin) })}</span>
        </div>
        {tags && tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map(tag => <TagBadge tag={tag} />)}
          </div>
        )}
      </header>
      <div class="prose prose-gray dark:prose-invert max-w-none">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
